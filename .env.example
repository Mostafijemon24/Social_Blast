# Copy to .env.local and fill in what you need. Nothing here is required for the demo.

# AI writing and AI images through OpenRouter (otherwise the template writer is used)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# Database: SQLite file by default; set DATABASE_URL for PostgreSQL (several servers / workers)
# DATABASE_URL=postgres://user:pass@host:5432/socialblast
# SB_DB_SSL=false
# SB_DB_POOL=10
# SB_DB_PATH=data/social-blast.db
# SB_SEED=true
# SB_DEMO_PASSWORD=socialblast-demo

# Encrypts stored social account tokens (required to connect accounts). Create with: openssl rand -base64 48
# Never change it after accounts are connected.
SB_ENCRYPTION_KEY=

# Social platform OAuth apps — see docs/GOING-LIVE.md
# Redirect URL for each: ${APP_URL}/api/oauth/<facebook|instagram|linkedin|x|pinterest|gbp>/callback
# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_VERSION=v23.0
# Comment → DM: needs extra Meta permissions (App Review) and the webhook at ${APP_URL}/api/webhooks/meta
# META_ENGAGEMENT=false
# META_WEBHOOK_VERIFY_TOKEN=
# Auto-boost: needs ads_management (App Review) and a Meta ad account; then reconnect Facebook/Instagram
# META_ADS=false
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_ORG_ACCESS=false
# LINKEDIN_API_VERSION=202509
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# PINTEREST_APP_ID=
# PINTEREST_APP_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Background worker and crawler
# SB_WORKER=on
# SB_CRAWL_MAX_PAGES=60

# Public address of the app, used in invite and reset email links (required in production)
# APP_URL=https://app.example.com

# Mail server for invites and password resets (without it, links are shown to admins instead)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Social Blast <no-reply@example.com>
# SMTP_SECURE=false

# Media: uploads go to ./data/uploads unless S3-compatible storage is set (needed for several servers)
# SB_UPLOAD_DIR=data/uploads
# SB_MAX_IMAGE_MB=15
# SB_MAX_VIDEO_MB=200
# SB_STORAGE=s3
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# AI images directly from OpenAI instead of OpenRouter (optional)
# SB_IMAGE_PROVIDER=openai
# OPENAI_API_KEY=
# SB_IMAGE_MODEL=gpt-image-1
# SB_IMAGE_COST_CENTS=5

# Monitoring and alerts (see docs/GOING-LIVE.md step 14)
# SB_HEALTH_TOKEN=            # /api/health?token=… shows details
# SB_ALERT_EMAIL=you@example.com
# SB_ALERT_WEBHOOK_URL=       # Slack / Discord / Teams / Google Chat incoming webhook
# SB_WORKER_STALE_SEC=180
# SB_ALERT_FAILURES=5
# SB_ALERT_REPEAT_MIN=360

# Backups
# SB_BACKUP_DIR=/var/backups/socialblast
# SB_BACKUP_HOUR=3            # UTC
# SB_BACKUP_KEEP_DAYS=14
# SB_BACKUP_S3_BUCKET=
# SB_BACKUP_S3_PREFIX=backups/

# Outbound HTTP proxy (otherwise HTTPS_PROXY / HTTP_PROXY / NO_PROXY are used)
# SB_PROXY_URL=http://user:pass@proxy:3128
# SB_NO_PROXY=localhost,.internal.example
# SB_USE_ENV_PROXY=true
# SB_PROXY_RESOLVES_DNS=false
