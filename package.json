{
  "name": "social-blast",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "db:reset": "rm -f data/social-blast.db",
    "worker": "node --conditions=react-server --import tsx src/worker/main.ts",
    "test:pg": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:to-postgres": "node --conditions=react-server --import tsx scripts/migrate-sqlite-to-pg.ts",
    "backup": "node --conditions=react-server --import tsx scripts/backup.ts"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@phosphor-icons/web": "^2.1.1",
    "exceljs": "^4.4.0",
    "next": "^15.5.28",
    "node-html-parser": "^9.0.4",
    "nodemailer": "^10.1.6",
    "pg": "^8.23.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
